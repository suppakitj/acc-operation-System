{
  "name": "TaxQA_ReviewLog",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d entity \u0e17\u0e35\u0e48\u0e40\u0e01\u0e35\u0e48\u0e22\u0e27\u0e02\u0e49\u0e2d\u0e07"
    },
    "entity_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07 entity"
    },
    "action": {
      "type": "string",
      "description": "\u0e01\u0e32\u0e23\u0e01\u0e23\u0e30\u0e17\u0e33 \u0e40\u0e0a\u0e48\u0e19 approve, reject, override, submit"
    },
    "actor_email": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e01\u0e23\u0e30\u0e17\u0e33"
    },
    "actor_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e01\u0e23\u0e30\u0e17\u0e33"
    },
    "timestamp": {
      "type": "string",
      "description": "\u0e27\u0e31\u0e19\u0e40\u0e27\u0e25\u0e32 (ISO datetime)"
    },
    "before_value": {
      "type": "string",
      "description": "\u0e04\u0e48\u0e32\u0e01\u0e48\u0e2d\u0e19\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19 (JSON string)"
    },
    "after_value": {
      "type": "string",
      "description": "\u0e04\u0e48\u0e32\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19 (JSON string)"
    },
    "note": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "entity_name",
    "entity_id",
    "action",
    "actor_email"
  ]
}