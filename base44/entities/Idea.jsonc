{
  "name": "Idea",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d\u0e44\u0e2d\u0e40\u0e14\u0e35\u0e22"
    },
    "description": {
      "type": "string",
      "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21"
    },
    "category": {
      "type": "string",
      "enum": [
        "process",
        "tool",
        "culture",
        "customer",
        "other"
      ],
      "default": "process",
      "description": "\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48\u0e44\u0e2d\u0e40\u0e14\u0e35\u0e22"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "considering",
        "planned",
        "done",
        "closed"
      ],
      "default": "open"
    },
    "vote_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19 upvote"
    },
    "voters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "list \u0e02\u0e2d\u0e07 email \u0e17\u0e35\u0e48 vote \u0e41\u0e25\u0e49\u0e27"
    },
    "admin_comment": {
      "type": "string",
      "description": "\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2b\u0e47\u0e19\u0e08\u0e32\u0e01 management"
    }
  },
  "required": [
    "title",
    "author_email"
  ]
}