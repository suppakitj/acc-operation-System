{
  "name": "PerformanceSnapshot",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "custom"
      ]
    },
    "period_key": {
      "type": "string",
      "description": "e.g. 2025-11 | 2025-Q4 | 2025 | 2025-11-01_2025-11-30"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "comparison_baseline": {
      "type": "string",
      "description": "previous_period | same_period_last_year | peer_group | personal_baseline | custom"
    },
    "overall_score": {
      "type": "number"
    },
    "grade": {
      "type": "string"
    },
    "e1_score": {
      "type": "number"
    },
    "e2_score": {
      "type": "number"
    },
    "e3_score": {
      "type": "number"
    },
    "dimensions_json": {
      "type": "string",
      "description": "Serialized full scorecard object from computeScorecard3E()"
    },
    "financial_json": {
      "type": "string",
      "description": "Serialized per-staff financial contribution"
    },
    "insights_json": {
      "type": "string",
      "description": "Serialized auto-generated strengths / development / coaching"
    },
    "recommended_action": {
      "type": "string",
      "description": "e.g. Retain & Reward | Coach | Monitor | PIP"
    },
    "compensation_signal": {
      "type": "string"
    },
    "evaluation_note": {
      "type": "string",
      "description": "Free-text reviewer note"
    },
    "locked": {
      "type": "boolean",
      "default": false,
      "description": "true = immutable formal record"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_by_name": {
      "type": "string"
    }
  }
}