{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e07\u0e32\u0e19"
    },
    "description": {
      "type": "string",
      "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e07\u0e32\u0e19"
    },
    "customer_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "accounting",
        "payroll",
        "tax_consulting",
        "audit",
        "peak_licensing"
      ],
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a (email)"
    },
    "assigned_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a"
    },
    "department": {
      "type": "string",
      "enum": [
        "management",
        "accounting",
        "consulting",
        "audit",
        "billing",
        "it"
      ],
      "description": "\u0e41\u0e1c\u0e19\u0e01"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "review",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e2a\u0e48\u0e07"
    },
    "original_due_date": {
      "type": "string",
      "format": "date",
      "description": "due_date \u0e15\u0e2d\u0e19\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e04\u0e23\u0e31\u0e49\u0e07\u0e41\u0e23\u0e01 (snapshot, immutable)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e40\u0e23\u0e34\u0e48\u0e21\u0e07\u0e32\u0e19"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e40\u0e2a\u0e23\u0e47\u0e08"
    },
    "reviewer_email": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a (Super Supervisor/Manager)"
    },
    "reviewer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a"
    },
    "review_deadline": {
      "type": "string",
      "format": "date",
      "description": "\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e2b\u0e31\u0e27\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e23\u0e27\u0e08 (auto = due_date + 2 \u0e27\u0e31\u0e19\u0e17\u0e33\u0e01\u0e32\u0e23)"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "description": "\u0e1c\u0e25\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a"
    },
    "review_note": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38\u0e08\u0e32\u0e01 reviewer (\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e17\u0e35\u0e48 reject)"
    },
    "checklist": {
      "type": "array",
      "description": "\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "\u0e1b\u0e31\u0e0d\u0e2b\u0e32\u0e17\u0e35\u0e48\u0e40\u0e08\u0e2d (Findings)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Finding ID (timestamp)"
          },
          "title": {
            "type": "string",
            "description": "\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d\u0e1b\u0e31\u0e0d\u0e2b\u0e32"
          },
          "description": {
            "type": "string",
            "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "medium",
              "low"
            ],
            "description": "\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e23\u0e38\u0e19\u0e41\u0e23\u0e07"
          },
          "recommendation": {
            "type": "string",
            "description": "\u0e04\u0e33\u0e41\u0e19\u0e30\u0e19\u0e33"
          },
          "photos": {
            "type": "array",
            "description": "\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e/\u0e44\u0e1f\u0e25\u0e4c\u0e41\u0e19\u0e1a",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "drive_url": {
                  "type": "string"
                },
                "drive_file_id": {
                  "type": "string"
                },
                "thumbnail_url": {
                  "type": "string"
                },
                "base44_url": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "\u0e07\u0e32\u0e19\u0e1b\u0e23\u0e30\u0e08\u0e33"
    },
    "recurring_type": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly"
      ],
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e07\u0e32\u0e19\u0e1b\u0e23\u0e30\u0e08\u0e33"
    },
    "template_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e40\u0e17\u0e21\u0e40\u0e1e\u0e25\u0e15"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e44\u0e1f\u0e25\u0e4c\u0e41\u0e19\u0e1a"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "due_date_change_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19 due date"
    },
    "due_date_change_history": {
      "type": "array",
      "description": "\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19 due date",
      "items": {
        "type": "object",
        "properties": {
          "changed_at": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_by_name": {
            "type": "string"
          },
          "changed_by_role": {
            "type": "string"
          },
          "old_due_date": {
            "type": "string"
          },
          "new_due_date": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "pending_due_change": {
      "type": "object",
      "description": "\u0e04\u0e33\u0e02\u0e2d\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19 due date \u0e17\u0e35\u0e48\u0e23\u0e2d\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34 (null \u0e16\u0e49\u0e32\u0e44\u0e21\u0e48\u0e21\u0e35)",
      "properties": {
        "requested_at": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "requested_by_name": {
          "type": "string"
        },
        "requested_by_role": {
          "type": "string"
        },
        "old_due_date": {
          "type": "string"
        },
        "new_due_date": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "rework_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48\u0e16\u0e39\u0e01 reject (major/critical)"
    },
    "rework_count_weighted": {
      "type": "number",
      "default": 0,
      "description": "\u0e04\u0e30\u0e41\u0e19\u0e19\u0e16\u0e48\u0e27\u0e07\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01 rework (minor=0.5, major=1, critical=2)"
    },
    "first_time_right": {
      "type": "boolean",
      "description": "true \u0e16\u0e49\u0e32 approved \u0e04\u0e23\u0e31\u0e49\u0e07\u0e41\u0e23\u0e01\u0e42\u0e14\u0e22\u0e44\u0e21\u0e48\u0e40\u0e04\u0e22\u0e16\u0e39\u0e01 reject"
    },
    "last_submitted_at": {
      "type": "string",
      "description": "ISO datetime \u0e15\u0e2d\u0e19 submit for review \u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14"
    },
    "submission_cycles": {
      "type": "array",
      "description": "\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e17\u0e38\u0e01 review cycle",
      "items": {
        "type": "object",
        "properties": {
          "cycle_no": {
            "type": "number"
          },
          "submitted_at": {
            "type": "string"
          },
          "submitted_by": {
            "type": "string"
          },
          "submitted_by_name": {
            "type": "string"
          },
          "decided_at": {
            "type": "string"
          },
          "decided_by": {
            "type": "string"
          },
          "decided_by_name": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "pending"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "major",
              "critical"
            ]
          },
          "category": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "turnaround_hours": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "status"
  ]
}