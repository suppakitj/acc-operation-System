{
  "name": "OcrJob",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e44\u0e1f\u0e25\u0e4c\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a"
    },
    "file_url": {
      "type": "string",
      "description": "URL \u0e44\u0e1f\u0e25\u0e4c\u0e17\u0e35\u0e48\u0e2d\u0e31\u0e1b\u0e42\u0e2b\u0e25\u0e14"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploading",
        "processing",
        "completed",
        "failed"
      ],
      "default": "uploading",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e1c\u0e25"
    },
    "ocr_engine": {
      "type": "string",
      "enum": [
        "manus",
        "aigen"
      ],
      "default": "manus",
      "description": "\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e21\u0e37\u0e2d OCR \u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49"
    },
    "aigen_doc_type": {
      "type": "string",
      "enum": [
        "general_ocr",
        "general_invoice",
        "table_extraction",
        "bank_statement",
        "payslip",
        "idcard"
      ],
      "default": "general_ocr",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23 aiScript"
    },
    "output_format": {
      "type": "string",
      "enum": [
        "excel",
        "word"
      ],
      "default": "excel",
      "description": "\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e44\u0e1f\u0e25\u0e4c\u0e1c\u0e25\u0e25\u0e31\u0e1e\u0e18\u0e4c\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23"
    },
    "custom_prompt": {
      "type": "string",
      "description": "\u0e04\u0e33\u0e2a\u0e31\u0e48\u0e07\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a OCR (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "manus_task_id": {
      "type": "string",
      "description": "Manus Task ID"
    },
    "manus_task_url": {
      "type": "string",
      "description": "Manus Task URL"
    },
    "output_file_url": {
      "type": "string",
      "description": "URL \u0e44\u0e1f\u0e25\u0e4c\u0e1c\u0e25\u0e25\u0e31\u0e1e\u0e18\u0e4c"
    },
    "gdrive_file_id": {
      "type": "string",
      "description": "Google Drive File ID \u0e02\u0e2d\u0e07\u0e44\u0e1f\u0e25\u0e4c\u0e17\u0e35\u0e48\u0e2d\u0e31\u0e1b\u0e42\u0e2b\u0e25\u0e14"
    },
    "error_message": {
      "type": "string",
      "description": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 error \u0e16\u0e49\u0e32\u0e21\u0e35"
    },
    "ocr_result": {
      "type": "string",
      "description": "\u0e1c\u0e25\u0e25\u0e31\u0e1e\u0e18\u0e4c OCR \u0e14\u0e34\u0e1a\u0e08\u0e32\u0e01 aiScript (JSON string)"
    },
    "customer_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32 (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32 (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "filename",
    "status"
  ]
}