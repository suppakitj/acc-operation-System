{
  "name": "TaxQA_ExceptionFlag",
  "type": "object",
  "properties": {
    "filing_id": {
      "type": "string",
      "description": "ref TaxQA_Filing ID"
    },
    "line_item_id": {
      "type": "string",
      "description": "ref TaxQA_LineItem ID (nullable \u2014 flag \u0e23\u0e30\u0e14\u0e31\u0e1a filing \u0e44\u0e21\u0e48\u0e21\u0e35 line)"
    },
    "rule_code": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e01\u0e0e\u0e17\u0e35\u0e48 trigger"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ],
      "default": "warning",
      "description": "\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e23\u0e38\u0e19\u0e41\u0e23\u0e07"
    },
    "message": {
      "type": "string",
      "description": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22 (\u0e20\u0e32\u0e29\u0e32\u0e44\u0e17\u0e22)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "overridden"
      ],
      "default": "open",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30 flag"
    },
    "resolved_by": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e41\u0e01\u0e49\u0e44\u0e02/override (ref User)"
    },
    "resolved_by_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e41\u0e01\u0e49\u0e44\u0e02"
    },
    "resolution_note": {
      "type": "string",
      "description": "\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e01\u0e32\u0e23 override/\u0e41\u0e01\u0e49\u0e44\u0e02"
    },
    "resolved_at": {
      "type": "string",
      "description": "\u0e27\u0e31\u0e19\u0e40\u0e27\u0e25\u0e32\u0e41\u0e01\u0e49\u0e44\u0e02 (ISO datetime)"
    }
  },
  "required": [
    "filing_id",
    "rule_code",
    "severity",
    "message"
  ]
}