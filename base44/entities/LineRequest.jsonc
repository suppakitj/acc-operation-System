{
  "name": "LineRequest",
  "type": "object",
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "tax_invoice",
        "withholding_cert",
        "sso_register",
        "sso_terminate"
      ],
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e04\u0e33\u0e02\u0e2d: \u0e2d\u0e2d\u0e01\u0e43\u0e1a\u0e01\u0e33\u0e01\u0e31\u0e1a\u0e20\u0e32\u0e29\u0e35, \u0e2d\u0e2d\u0e01\u0e43\u0e1a\u0e2b\u0e31\u0e01 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22, \u0e41\u0e08\u0e49\u0e07\u0e40\u0e02\u0e49\u0e32\u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e2a\u0e31\u0e07\u0e04\u0e21, \u0e41\u0e08\u0e49\u0e07\u0e2d\u0e2d\u0e01\u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e2a\u0e31\u0e07\u0e04\u0e21"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30"
    },
    "customer_id": {
      "type": "string",
      "description": "ref Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"
    },
    "line_user_id": {
      "type": "string",
      "description": "LINE user/group ID \u0e17\u0e35\u0e48\u0e2a\u0e48\u0e07\u0e04\u0e33\u0e02\u0e2d"
    },
    "chat_type": {
      "type": "string",
      "enum": [
        "user",
        "group"
      ],
      "default": "user"
    },
    "sender_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e2a\u0e48\u0e07\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21"
    },
    "original_message": {
      "type": "string",
      "description": "\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e08\u0e32\u0e01 LINE"
    },
    "message_id": {
      "type": "string",
      "description": "ref LineMessage ID"
    },
    "details": {
      "type": "string",
      "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e17\u0e35\u0e48 AI \u0e2a\u0e01\u0e31\u0e14\u0e44\u0e14\u0e49 (\u0e0a\u0e37\u0e48\u0e2d, \u0e08\u0e33\u0e19\u0e27\u0e19, \u0e27\u0e31\u0e19\u0e17\u0e35\u0e48 \u0e2f\u0e25\u0e2f)"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a (email)"
    },
    "assigned_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a"
    },
    "task_id": {
      "type": "string",
      "description": "ref Task ID \u0e17\u0e35\u0e48\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e08\u0e32\u0e01\u0e04\u0e33\u0e02\u0e2d\u0e19\u0e35\u0e49"
    },
    "completed_at": {
      "type": "string",
      "description": "\u0e27\u0e31\u0e19\u0e40\u0e27\u0e25\u0e32\u0e17\u0e35\u0e48\u0e1b\u0e34\u0e14\u0e07\u0e32\u0e19 (ISO datetime)"
    },
    "completed_by": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e1b\u0e34\u0e14\u0e07\u0e32\u0e19"
    },
    "completed_by_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e1b\u0e34\u0e14\u0e07\u0e32\u0e19"
    },
    "note": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    }
  },
  "required": [
    "request_type",
    "status",
    "original_message"
  ]
}