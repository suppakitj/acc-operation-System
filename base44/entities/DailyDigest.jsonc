{
  "name": "DailyDigest",
  "type": "object",
  "properties": {
    "digest_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e02\u0e2d\u0e07\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e17\u0e35\u0e48\u0e2a\u0e23\u0e38\u0e1b (\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e27\u0e32\u0e19)"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO datetime \u0e17\u0e35\u0e48\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e23\u0e32\u0e22\u0e07\u0e32\u0e19"
    },
    "mention_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e17\u0e35\u0e48\u0e1e\u0e39\u0e14\u0e16\u0e36\u0e07\u0e40\u0e23\u0e32"
    },
    "actionable_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e47\u0e19\u0e04\u0e33\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19"
    },
    "new_in_queue": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e17\u0e35\u0e48\u0e22\u0e31\u0e07\u0e04\u0e49\u0e32\u0e07\u0e43\u0e19\u0e04\u0e34\u0e27\u0e23\u0e31\u0e1a\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07"
    },
    "overdue_task_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e07\u0e32\u0e19\u0e40\u0e25\u0e22\u0e01\u0e33\u0e2b\u0e19\u0e14"
    },
    "unassigned_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e07\u0e32\u0e19\u0e17\u0e35\u0e48\u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e21\u0e35\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a"
    },
    "pending_request_count": {
      "type": "number",
      "default": 0,
      "description": "LineRequest \u0e17\u0e35\u0e48\u0e22\u0e31\u0e07 pending"
    },
    "summary_markdown": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e23\u0e32\u0e22\u0e07\u0e32\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e40\u0e15\u0e47\u0e21"
    },
    "top_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "customer_name": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "urgency": {
            "type": "string"
          },
          "line_message_id": {
            "type": "string"
          }
        }
      }
    },
    "sent_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LINE target \u0e17\u0e35\u0e48\u0e2a\u0e48\u0e07\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08"
    }
  },
  "required": [
    "digest_date"
  ]
}