{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d\u0e1b\u0e23\u0e30\u0e01\u0e32\u0e28"
    },
    "content": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32 (markdown)"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "celebration",
        "reminder",
        "urgent"
      ],
      "default": "info"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e2b\u0e21\u0e14\u0e2d\u0e32\u0e22\u0e38\u0e01\u0e32\u0e23\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25 (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "target_departments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "management",
          "accounting",
          "consulting",
          "audit",
          "billing",
          "it"
        ]
      },
      "description": "\u0e41\u0e1c\u0e19\u0e01\u0e17\u0e35\u0e48\u0e40\u0e2b\u0e47\u0e19 (\u0e27\u0e48\u0e32\u0e07 = \u0e17\u0e38\u0e01\u0e04\u0e19)"
    }
  },
  "required": [
    "title",
    "content",
    "author_email"
  ]
}