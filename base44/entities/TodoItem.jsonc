{
  "name": "TodoItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e17\u0e33"
    },
    "is_done": {
      "type": "boolean",
      "default": false
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e27\u0e31\u0e19 (optional \u2014 \u0e16\u0e49\u0e32\u0e15\u0e31\u0e49\u0e07\u0e08\u0e30\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a email \u0e40\u0e15\u0e37\u0e2d\u0e19)"
    },
    "owner_email": {
      "type": "string",
      "description": "email \u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07 to-do"
    },
    "owner_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "owner_email"
  ]
}