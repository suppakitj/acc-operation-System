{
  "name": "TaxQA_CompanyTaxProfile",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "ref Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32 (denormalized)"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false,
      "description": "\u0e08\u0e14\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19 VAT \u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "pnd1_applicable": {
      "type": "boolean",
      "default": true,
      "description": "\u0e21\u0e35\u0e20\u0e32\u0e23\u0e30 \u0e20\u0e07\u0e14.1 \u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "has_foreign_payment": {
      "type": "boolean",
      "default": false,
      "description": "\u0e21\u0e35\u0e01\u0e32\u0e23\u0e08\u0e48\u0e32\u0e22\u0e40\u0e07\u0e34\u0e19\u0e44\u0e1b\u0e15\u0e48\u0e32\u0e07\u0e1b\u0e23\u0e30\u0e40\u0e17\u0e28 (\u0e20\u0e07\u0e14.54/\u0e20\u0e1e.36)"
    },
    "filing_method": {
      "type": "string",
      "enum": [
        "paper",
        "e-filing"
      ],
      "default": "e-filing",
      "description": "\u0e27\u0e34\u0e18\u0e35\u0e22\u0e37\u0e48\u0e19\u0e20\u0e32\u0e29\u0e35"
    }
  },
  "required": [
    "customer_id",
    "customer_name"
  ]
}