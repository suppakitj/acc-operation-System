{
  "name": "Billing",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48\u0e43\u0e1a\u0e41\u0e08\u0e49\u0e07\u0e2b\u0e19\u0e35\u0e49"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "accounting",
        "payroll",
        "tax_consulting",
        "audit",
        "peak_licensing"
      ]
    },
    "department": {
      "type": "string",
      "enum": [
        "management",
        "accounting",
        "consulting",
        "audit",
        "billing",
        "it"
      ]
    },
    "description": {
      "type": "string"
    },
    "service_amount": {
      "type": "number",
      "description": "\u0e04\u0e48\u0e32\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23 (\u0e43\u0e0a\u0e49\u0e04\u0e34\u0e14\u0e04\u0e48\u0e32\u0e41\u0e19\u0e30\u0e19\u0e33)"
    },
    "extra_costs": {
      "type": "array",
      "description": "\u0e04\u0e48\u0e32\u0e43\u0e0a\u0e49\u0e08\u0e48\u0e32\u0e22\u0e2d\u0e37\u0e48\u0e19\u0e46 \u0e40\u0e0a\u0e48\u0e19 \u0e04\u0e48\u0e32\u0e40\u0e14\u0e34\u0e19\u0e17\u0e32\u0e07 \u0e04\u0e48\u0e32\u0e42\u0e23\u0e07\u0e41\u0e23\u0e21",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 \u0e40\u0e0a\u0e48\u0e19 \u0e04\u0e48\u0e32\u0e40\u0e14\u0e34\u0e19\u0e17\u0e32\u0e07"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "amount": {
      "type": "number",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19\u0e23\u0e27\u0e21 (\u0e04\u0e48\u0e32\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23 + \u0e04\u0e48\u0e32\u0e43\u0e0a\u0e49\u0e08\u0e48\u0e32\u0e22\u0e2d\u0e37\u0e48\u0e19\u0e46)"
    },
    "vat": {
      "type": "number",
      "description": "\u0e20\u0e32\u0e29\u0e35\u0e21\u0e39\u0e25\u0e04\u0e48\u0e32\u0e40\u0e1e\u0e34\u0e48\u0e21"
    },
    "wht_amount": {
      "type": "number",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19 WHT"
    },
    "total_amount": {
      "type": "number",
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e40\u0e07\u0e34\u0e19\u0e23\u0e27\u0e21\u0e2a\u0e38\u0e17\u0e18\u0e34"
    },
    "billing_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled",
        "not_invoiced"
      ],
      "default": "draft"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "transfer",
        "cash",
        "cheque",
        "credit_card",
        "other"
      ]
    },
    "payment_proof_url": {
      "type": "string"
    },
    "receipt_received": {
      "type": "boolean",
      "default": false,
      "description": "\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e43\u0e1a\u0e40\u0e2a\u0e23\u0e47\u0e08\u0e41\u0e25\u0e49\u0e27\u0e2b\u0e23\u0e37\u0e2d\u0e22\u0e31\u0e07"
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "wht_received": {
      "type": "boolean",
      "default": false,
      "description": "\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a WHT \u0e41\u0e25\u0e49\u0e27\u0e2b\u0e23\u0e37\u0e2d\u0e22\u0e31\u0e07"
    },
    "wht_date": {
      "type": "string",
      "format": "date"
    },
    "referral_commission": {
      "type": "boolean",
      "default": false,
      "description": "\u0e08\u0e48\u0e32\u0e22\u0e04\u0e48\u0e32\u0e41\u0e19\u0e30\u0e19\u0e33\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1a\u0e34\u0e25\u0e19\u0e35\u0e49\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "owner": {
      "type": "string",
      "description": "\u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07\u0e07\u0e32\u0e19 (\u0e0a\u0e37\u0e48\u0e2d)"
    },
    "owner_email": {
      "type": "string",
      "description": "email \u0e40\u0e08\u0e49\u0e32\u0e02\u0e2d\u0e07\u0e07\u0e32\u0e19"
    },
    "notes": {
      "type": "string"
    },
    "period_month": {
      "type": "string",
      "description": "\u0e07\u0e27\u0e14\u0e40\u0e14\u0e37\u0e2d\u0e19 \u0e40\u0e0a\u0e48\u0e19 2026-01"
    }
  },
  "required": [
    "customer_name",
    "amount"
  ]
}