{
  "name": "TaxDeadline",
  "type": "object",
  "properties": {
    "tax_type": {
      "type": "string",
      "enum": [
        "pnd1",
        "pnd2",
        "pnd3",
        "pnd53",
        "pnd54",
        "pp30",
        "pp36",
        "pt40",
        "sso"
      ],
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e20\u0e32\u0e29\u0e35/\u0e40\u0e07\u0e34\u0e19\u0e2a\u0e21\u0e17\u0e1a"
    },
    "tax_label": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e41\u0e2a\u0e14\u0e07\u0e1c\u0e25 \u0e40\u0e0a\u0e48\u0e19 '\u0e20.\u0e07.\u0e14.1', '\u0e20.\u0e1e.30', '\u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e2a\u0e31\u0e07\u0e04\u0e21'"
    },
    "for_month": {
      "type": "number",
      "description": "\u0e40\u0e14\u0e37\u0e2d\u0e19\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e47\u0e19\u0e23\u0e2d\u0e1a\u0e20\u0e32\u0e29\u0e35 (1-12)"
    },
    "for_year": {
      "type": "number",
      "description": "\u0e1b\u0e35 \u0e04.\u0e28. \u0e02\u0e2d\u0e07\u0e23\u0e2d\u0e1a\u0e20\u0e32\u0e29\u0e35"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e22\u0e37\u0e48\u0e19\u0e2d\u0e2d\u0e19\u0e44\u0e25\u0e19\u0e4c (\u0e2b\u0e25\u0e31\u0e07\u0e40\u0e0a\u0e47\u0e04\u0e27\u0e31\u0e19\u0e2b\u0e22\u0e38\u0e14\u0e41\u0e25\u0e49\u0e27)"
    },
    "original_day": {
      "type": "number",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e40\u0e14\u0e34\u0e21 (\u0e01\u0e48\u0e2d\u0e19\u0e40\u0e0a\u0e47\u0e04\u0e27\u0e31\u0e19\u0e2b\u0e22\u0e38\u0e14) \u0e40\u0e0a\u0e48\u0e19 15, 23, 25"
    },
    "was_shifted": {
      "type": "boolean",
      "default": false,
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e16\u0e39\u0e01\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e08\u0e32\u0e01\u0e27\u0e31\u0e19\u0e2b\u0e22\u0e38\u0e14\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "shift_reason": {
      "type": "string",
      "description": "\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e17\u0e35\u0e48\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19 \u0e40\u0e0a\u0e48\u0e19 '\u0e15\u0e23\u0e07\u0e27\u0e31\u0e19\u0e40\u0e2a\u0e32\u0e23\u0e4c', '\u0e27\u0e31\u0e19\u0e2b\u0e22\u0e38\u0e14\u0e2a\u0e07\u0e01\u0e23\u0e32\u0e19\u0e15\u0e4c'"
    },
    "category": {
      "type": "string",
      "enum": [
        "withholding_tax",
        "vat",
        "sbt",
        "sso"
      ],
      "description": "\u0e2b\u0e21\u0e27\u0e14: \u0e20\u0e32\u0e29\u0e35\u0e2b\u0e31\u0e01 \u0e13 \u0e17\u0e35\u0e48\u0e08\u0e48\u0e32\u0e22, VAT, \u0e18\u0e38\u0e23\u0e01\u0e34\u0e08\u0e40\u0e09\u0e1e\u0e32\u0e30, \u0e1b\u0e23\u0e30\u0e01\u0e31\u0e19\u0e2a\u0e31\u0e07\u0e04\u0e21"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "generated_by": {
      "type": "string"
    }
  },
  "required": [
    "tax_type",
    "tax_label",
    "for_month",
    "for_year",
    "deadline"
  ]
}