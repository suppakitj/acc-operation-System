{
  "name": "KpiReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "yearly",
        "custom"
      ]
    },
    "period_key": {
      "type": "string"
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "firm_health_overall": {
      "type": "number"
    },
    "firm_health_operational": {
      "type": "number"
    },
    "firm_health_financial": {
      "type": "number"
    },
    "kpi_json": {
      "type": "string",
      "description": "Serialized full report data snapshot (immutable numbers as-reported)"
    },
    "ai_executive_summary": {
      "type": "string"
    },
    "ai_highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pdf_url": {
      "type": "string",
      "description": "Uploaded PDF URL for re-download"
    },
    "email_sent_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "completed",
        "failed"
      ],
      "default": "generating"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ]
}