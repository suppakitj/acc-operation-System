{
  "name": "DirectorInfo",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "ref Customer"
    },
    "customer_name": {
      "type": "string"
    },
    "full_name_encrypted": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d-\u0e19\u0e32\u0e21\u0e2a\u0e01\u0e38\u0e25 \u0e01\u0e23\u0e23\u0e21\u0e01\u0e32\u0e23 (AES-GCM encrypted)"
    },
    "id_card_encrypted": {
      "type": "string",
      "description": "\u0e40\u0e25\u0e02\u0e1a\u0e31\u0e15\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e32\u0e0a\u0e19 13 \u0e2b\u0e25\u0e31\u0e01 (encrypted)"
    },
    "address_encrypted": {
      "type": "string",
      "description": "\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48\u0e15\u0e32\u0e21\u0e1a\u0e31\u0e15\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e32\u0e0a\u0e19 (encrypted)"
    },
    "phone_encrypted": {
      "type": "string",
      "description": "\u0e40\u0e1a\u0e2d\u0e23\u0e4c\u0e42\u0e17\u0e23\u0e01\u0e23\u0e23\u0e21\u0e01\u0e32\u0e23 (encrypted)"
    },
    "position": {
      "type": "string",
      "description": "\u0e15\u0e33\u0e41\u0e2b\u0e19\u0e48\u0e07 \u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e23\u0e23\u0e21\u0e01\u0e32\u0e23\u0e1c\u0e39\u0e49\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23"
    },
    "tax_filing_type": {
      "type": "string",
      "enum": [
        "pnd90",
        "pnd91",
        "both",
        "none"
      ],
      "default": "pnd91",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17 \u0e20\u0e07\u0e14. \u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e22\u0e37\u0e48\u0e19"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    },
    "last_modified_by": {
      "type": "string"
    },
    "last_modified_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "full_name_encrypted"
  ]
}