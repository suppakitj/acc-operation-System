{
  "name": "TaxQA_ValidationRule",
  "type": "object",
  "properties": {
    "rule_code": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e01\u0e0e unique"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "PND1",
        "PND3",
        "PND53",
        "PND54",
        "PP36",
        "PP30",
        "ALL"
      ],
      "description": "\u0e41\u0e1a\u0e1a\u0e20\u0e32\u0e29\u0e35\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49"
    },
    "description": {
      "type": "string",
      "description": "\u0e04\u0e33\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22\u0e01\u0e0e (\u0e44\u0e17\u0e22)"
    },
    "rule_category": {
      "type": "string",
      "enum": [
        "structural",
        "rate",
        "cross_form",
        "continuity",
        "reconciliation",
        "ingestion"
      ],
      "description": "\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48\u0e01\u0e0e"
    },
    "severity_default": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ],
      "default": "warning",
      "description": "\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e23\u0e38\u0e19\u0e41\u0e23\u0e07\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19"
    },
    "parameters": {
      "type": "object",
      "description": "\u0e1e\u0e32\u0e23\u0e32\u0e21\u0e34\u0e40\u0e15\u0e2d\u0e23\u0e4c JSON \u0e02\u0e2d\u0e07\u0e01\u0e0e"
    },
    "legal_reference": {
      "type": "string",
      "description": "\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e01\u0e0e\u0e2b\u0e21\u0e32\u0e22"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e21\u0e35\u0e1c\u0e25\u0e1a\u0e31\u0e07\u0e04\u0e31\u0e1a\u0e43\u0e0a\u0e49"
    }
  },
  "required": [
    "rule_code",
    "form_type",
    "description",
    "rule_category"
  ]
}