        "religious",
        "special",
        "company"
      ],
      "default": "national",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e27\u0e31\u0e19\u0e2b\u0e22\u0e38\u0e14"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
