{
  "name": "TaxQA_WhtRateTable",
  "type": "object",
  "properties": {
    "income_type": {
      "type": "string",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e40\u0e07\u0e34\u0e19\u0e44\u0e14\u0e49"
    },
    "payee_type": {
      "type": "string",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a \u0e40\u0e0a\u0e48\u0e19 individual, juristic, individual/juristic"
    },
    "rate": {
      "type": "number",
      "description": "\u0e2d\u0e31\u0e15\u0e23\u0e32\u0e20\u0e32\u0e29\u0e35 (%)"
    },
    "legal_reference": {
      "type": "string",
      "description": "\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e01\u0e0e\u0e2b\u0e21\u0e32\u0e22"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e21\u0e35\u0e1c\u0e25\u0e1a\u0e31\u0e07\u0e04\u0e31\u0e1a\u0e43\u0e0a\u0e49"
    },
    "is_dta_adjustable": {
      "type": "boolean",
      "default": false,
      "description": "\u0e1b\u0e23\u0e31\u0e1a\u0e15\u0e32\u0e21 DTA \u0e44\u0e14\u0e49\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48 (\u0e20\u0e07\u0e14.54)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    }
  },
  "required": [
    "income_type",
    "payee_type",
    "rate"
  ]
}