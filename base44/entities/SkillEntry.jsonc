{
  "name": "SkillEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01"
    },
    "user_name": {
      "type": "string"
    },
    "skill_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e17\u0e31\u0e01\u0e29\u0e30"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ],
      "default": "beginner",
      "description": "\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e1b\u0e31\u0e08\u0e08\u0e38\u0e1a\u0e31\u0e19"
    },
    "is_goal": {
      "type": "boolean",
      "default": false,
      "description": "true = \u0e17\u0e31\u0e01\u0e29\u0e30\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e32\u0e01\u0e1e\u0e31\u0e12\u0e19\u0e32"
    },
    "category": {
      "type": "string",
      "enum": [
        "accounting",
        "tax",
        "audit",
        "software",
        "soft_skill",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21"
    }
  },
  "required": [
    "user_email",
    "skill_name"
  ]
}