{
  "name": "LineMessage",
  "type": "object",
  "properties": {
    "line_user_id": {
      "type": "string",
      "description": "LINE user ID \u0e2b\u0e23\u0e37\u0e2d group ID (\u0e43\u0e0a\u0e49\u0e40\u0e1b\u0e47\u0e19 chat key)"
    },
    "display_name": {
      "type": "string"
    },
    "profile_image": {
      "type": "string"
    },
    "sender_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e2a\u0e48\u0e07\u0e08\u0e23\u0e34\u0e07 (\u0e43\u0e19 group \u0e08\u0e30\u0e40\u0e1b\u0e47\u0e19\u0e0a\u0e37\u0e48\u0e2d\u0e2a\u0e21\u0e32\u0e0a\u0e34\u0e01)"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "sticker",
        "file"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "incoming",
        "outgoing"
      ],
      "default": "incoming"
    },
    "file_url": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "replied_by": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e17\u0e35\u0e48\u0e15\u0e2d\u0e1a\u0e01\u0e25\u0e31\u0e1a"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "chat_type": {
      "type": "string",
      "enum": [
        "user",
        "group"
      ],
      "default": "user",
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e41\u0e0a\u0e17: user = \u0e2a\u0e48\u0e27\u0e19\u0e15\u0e31\u0e27, group = \u0e01\u0e25\u0e38\u0e48\u0e21"
    },
    "drive_saved": {
      "type": "boolean",
      "default": false,
      "description": "\u0e44\u0e1f\u0e25\u0e4c\u0e16\u0e39\u0e01 save \u0e44\u0e1b Google Drive \u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08\u0e41\u0e25\u0e49\u0e27\u0e2b\u0e23\u0e37\u0e2d\u0e22\u0e31\u0e07"
    },
    "drive_retry_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48 retry save \u0e44\u0e1b Drive"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "tax_invoice",
        "wht_cert",
        "sso_enroll",
        "sso_terminate",
        "other"
      ],
      "description": "\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e04\u0e33\u0e02\u0e2d\u0e17\u0e35\u0e48\u0e23\u0e30\u0e1a\u0e1a\u0e08\u0e31\u0e1a\u0e44\u0e14\u0e49"
    },
    "is_actionable": {
      "type": "boolean",
      "default": false,
      "description": "\u0e19\u0e48\u0e32\u0e08\u0e30\u0e40\u0e1b\u0e47\u0e19\u0e04\u0e33\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23"
    },
    "has_statutory_deadline": {
      "type": "boolean",
      "default": false,
      "description": "\u0e04\u0e33\u0e02\u0e2d\u0e17\u0e35\u0e48\u0e21\u0e35\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e15\u0e32\u0e21\u0e01\u0e0e\u0e2b\u0e21\u0e32\u0e22 (\u0e15\u0e49\u0e2d\u0e07\u0e23\u0e35\u0e1a)"
    },
    "auto_priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "description": "\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e17\u0e35\u0e48\u0e23\u0e30\u0e1a\u0e1a\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19"
    },
    "triage_status": {
      "type": "string",
      "enum": [
        "new",
        "task_created",
        "dismissed"
      ],
      "default": "new",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e01\u0e32\u0e23\u0e04\u0e31\u0e14\u0e01\u0e23\u0e2d\u0e07"
    },
    "task_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a Task \u0e17\u0e35\u0e48\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e08\u0e32\u0e01\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e19\u0e35\u0e49 (\u0e1c\u0e39\u0e01\u0e01\u0e25\u0e31\u0e1a)"
    },
    "multi_request": {
      "type": "boolean",
      "default": false,
      "description": "\u0e21\u0e35\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e33\u0e02\u0e2d\u0e43\u0e19\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e40\u0e14\u0e35\u0e22\u0e27"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "\u0e1e\u0e1a\u0e04\u0e33\u0e1b\u0e0f\u0e34\u0e40\u0e2a\u0e18/\u0e01\u0e33\u0e01\u0e27\u0e21 \u0e15\u0e49\u0e2d\u0e07\u0e43\u0e2b\u0e49\u0e04\u0e19\u0e15\u0e23\u0e27\u0e08\u0e01\u0e48\u0e2d\u0e19"
    },
    "dismissed_by": {
      "type": "string"
    },
    "dismissed_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "dismiss_reason": {
      "type": "string"
    }
  },
  "required": [
    "content"
  ]
}