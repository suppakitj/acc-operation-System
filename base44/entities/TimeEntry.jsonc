{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07 Task \u0e17\u0e35\u0e48\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32"
    },
    "task_title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d Task"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "accounting",
        "payroll",
        "tax_consulting",
        "audit",
        "peak_licensing"
      ]
    },
    "department": {
      "type": "string",
      "enum": [
        "management",
        "accounting",
        "consulting",
        "audit",
        "billing",
        "it"
      ]
    },
    "user_email": {
      "type": "string",
      "description": "\u0e1c\u0e39\u0e49\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e40\u0e27\u0e25\u0e32"
    },
    "user_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0e40\u0e27\u0e25\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u0e40\u0e27\u0e25\u0e32\u0e2a\u0e34\u0e49\u0e19\u0e2a\u0e38\u0e14"
    },
    "duration_minutes": {
      "type": "number",
      "description": "\u0e23\u0e30\u0e22\u0e30\u0e40\u0e27\u0e25\u0e32 (\u0e19\u0e32\u0e17\u0e35)"
    },
    "description": {
      "type": "string",
      "description": "\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e07\u0e32\u0e19\u0e17\u0e35\u0e48\u0e17\u0e33"
    },
    "is_running": {
      "type": "boolean",
      "default": false,
      "description": "\u0e01\u0e33\u0e25\u0e31\u0e07\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32\u0e2d\u0e22\u0e39\u0e48\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "is_overtime": {
      "type": "boolean",
      "default": false,
      "description": "\u0e40\u0e1b\u0e47\u0e19\u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07 OT \u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    }
  },
  "required": [
    "task_id",
    "user_email",
    "start_time"
  ]
}