{
  "name": "MeetingNote",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0e2b\u0e31\u0e27\u0e02\u0e49\u0e2d\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e38\u0e21/\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19 \u0e40\u0e0a\u0e48\u0e19 '1-on-1 \u0e2a\u0e21\u0e0a\u0e32\u0e22 \u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07 \u0e1b\u0e34\u0e14\u0e07\u0e1a ABC'"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e1b\u0e23\u0e30\u0e0a\u0e38\u0e21"
    },
    "manager_email": {
      "type": "string",
      "description": "email \u0e2b\u0e31\u0e27\u0e2b\u0e19\u0e49\u0e32\u0e17\u0e35\u0e48\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19"
    },
    "manager_name": {
      "type": "string"
    },
    "staff_email": {
      "type": "string",
      "description": "email \u0e25\u0e39\u0e01\u0e19\u0e49\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e16\u0e39\u0e01\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19 (legacy single)"
    },
    "staff_name": {
      "type": "string"
    },
    "staff_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "email \u0e25\u0e39\u0e01\u0e19\u0e49\u0e2d\u0e07\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19"
    },
    "staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e19\u0e49\u0e2d\u0e07\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19"
    },
    "notes": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e17\u0e35\u0e48\u0e04\u0e38\u0e22/\u0e2a\u0e31\u0e48\u0e07\u0e07\u0e32\u0e19 (free text)"
    },
    "action_items": {
      "type": "array",
      "description": "\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e17\u0e33",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID \u0e02\u0e2d\u0e07 action item"
          },
          "text": {
            "type": "string",
            "description": "\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e17\u0e33"
          },
          "done": {
            "type": "boolean",
            "description": "\u0e17\u0e33\u0e41\u0e25\u0e49\u0e27\u0e2b\u0e23\u0e37\u0e2d\u0e22\u0e31\u0e07"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e40\u0e2a\u0e23\u0e47\u0e08"
          },
          "original_due_date": {
            "type": "string",
            "format": "date",
            "description": "due_date \u0e15\u0e2d\u0e19\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e04\u0e23\u0e31\u0e49\u0e07\u0e41\u0e23\u0e01"
          },
          "assignee_email": {
            "type": "string",
            "description": "email \u0e1c\u0e39\u0e49\u0e23\u0e31\u0e1a\u0e1c\u0e34\u0e14\u0e0a\u0e2d\u0e1a\u0e40\u0e14\u0e35\u0e48\u0e22\u0e27"
          },
          "assignee_name": {
            "type": "string"
          },
          "closed_at": {
            "type": "string",
            "description": "\u0e40\u0e27\u0e25\u0e32\u0e17\u0e35\u0e48\u0e15\u0e34\u0e4a\u0e01 done (ISO datetime)"
          },
          "closed_by": {
            "type": "string",
            "description": "email \u0e1c\u0e39\u0e49\u0e1b\u0e34\u0e14"
          },
          "closed_by_name": {
            "type": "string"
          },
          "postpone_count": {
            "type": "number",
            "default": 0,
            "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19 due_date \u0e17\u0e35\u0e48\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34\u0e41\u0e25\u0e49\u0e27"
          },
          "postpone_history": {
            "type": "array",
            "description": "\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e17\u0e38\u0e01 event",
            "items": {
              "type": "object",
              "properties": {
                "requested_at": {
                  "type": "string"
                },
                "requested_by": {
                  "type": "string"
                },
                "requested_by_name": {
                  "type": "string"
                },
                "requested_by_role": {
                  "type": "string"
                },
                "old_due_date": {
                  "type": "string"
                },
                "new_due_date": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "decision": {
                  "type": "string"
                },
                "decided_at": {
                  "type": "string"
                },
                "decided_by": {
                  "type": "string"
                },
                "decided_by_name": {
                  "type": "string"
                },
                "decision_note": {
                  "type": "string"
                }
              }
            }
          },
          "pending_postpone": {
            "type": "object",
            "description": "\u0e04\u0e33\u0e02\u0e2d\u0e23\u0e2d\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34 (null \u0e16\u0e49\u0e32\u0e44\u0e21\u0e48\u0e21\u0e35)",
            "properties": {
              "requested_at": {
                "type": "string"
              },
              "requested_by": {
                "type": "string"
              },
              "requested_by_name": {
                "type": "string"
              },
              "old_due_date": {
                "type": "string"
              },
              "new_due_date": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "\u0e27\u0e31\u0e19 follow-up \u0e04\u0e23\u0e31\u0e49\u0e07\u0e16\u0e31\u0e14\u0e44\u0e1b (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32\u0e17\u0e35\u0e48\u0e40\u0e01\u0e35\u0e48\u0e22\u0e27\u0e02\u0e49\u0e2d\u0e07 (optional)"
    }
  },
  "required": [
    "title",
    "manager_email",
    "meeting_date"
  ]
}