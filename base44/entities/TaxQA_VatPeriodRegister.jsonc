{
  "name": "TaxQA_VatPeriodRegister",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "ref Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32 (denormalized)"
    },
    "tax_period": {
      "type": "string",
      "description": "\u0e07\u0e27\u0e14\u0e20\u0e32\u0e29\u0e35 YYYY-MM"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19 (1=\u0e09\u0e1a\u0e31\u0e1a\u0e1b\u0e01\u0e15\u0e34, 2+=\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21)"
    },
    "output_vat": {
      "type": "number",
      "default": 0,
      "description": "\u0e20\u0e32\u0e29\u0e35\u0e02\u0e32\u0e22"
    },
    "input_vat": {
      "type": "number",
      "default": 0,
      "description": "\u0e20\u0e32\u0e29\u0e35\u0e0b\u0e37\u0e49\u0e2d"
    },
    "credit_brought_forward": {
      "type": "number",
      "default": 0,
      "description": "\u0e40\u0e04\u0e23\u0e14\u0e34\u0e15\u0e22\u0e01\u0e21\u0e32"
    },
    "credit_carried_forward": {
      "type": "number",
      "default": 0,
      "description": "\u0e40\u0e04\u0e23\u0e14\u0e34\u0e15\u0e22\u0e01\u0e44\u0e1b"
    },
    "net_payable": {
      "type": "number",
      "default": 0,
      "description": "\u0e20\u0e32\u0e29\u0e35\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e0a\u0e33\u0e23\u0e30 (\u0e2a\u0e38\u0e17\u0e18\u0e34)"
    },
    "status": {
      "type": "string",
      "enum": [
        "filed",
        "amended"
      ],
      "default": "filed",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30"
    },
    "source_filing_id": {
      "type": "string",
      "description": "ref TaxQA_Filing ID"
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "tax_period"
  ]
}