{
  "name": "PulseResponse",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e15\u0e2d\u0e1a"
    },
    "user_name": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "description": "\u0e41\u0e1c\u0e19\u0e01\u0e02\u0e2d\u0e07\u0e1c\u0e39\u0e49\u0e15\u0e2d\u0e1a \u0e13 \u0e40\u0e27\u0e25\u0e32\u0e17\u0e35\u0e48\u0e15\u0e2d\u0e1a"
    },
    "mood": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "neutral",
        "stressed",
        "burned_out"
      ],
      "description": "\u0e04\u0e27\u0e32\u0e21\u0e23\u0e39\u0e49\u0e2a\u0e36\u0e01\u0e02\u0e2d\u0e07\u0e1e\u0e19\u0e31\u0e01\u0e07\u0e32\u0e19"
    },
    "comment": {
      "type": "string",
      "description": "\u0e04\u0e27\u0e32\u0e21\u0e04\u0e34\u0e14\u0e40\u0e2b\u0e47\u0e19\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21 (optional)"
    },
    "week_key": {
      "type": "string",
      "description": "\u0e2a\u0e31\u0e1b\u0e14\u0e32\u0e2b\u0e4c\u0e17\u0e35\u0e48\u0e15\u0e2d\u0e1a format yyyy-Www \u0e40\u0e0a\u0e48\u0e19 2025-W28"
    }
  },
  "required": [
    "user_email",
    "mood",
    "week_key"
  ]
}