{
  "name": "CustomerCredential",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32 (ref Customer)"
    },
    "customer_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"
    },
    "service_id": {
      "type": "string",
      "description": "\u0e23\u0e2b\u0e31\u0e2a ExternalService (ref ExternalService)"
    },
    "service_code": {
      "type": "string",
      "description": "code \u0e02\u0e2d\u0e07 ExternalService"
    },
    "service_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23"
    },
    "username": {
      "type": "string",
      "description": "Username (encrypted)"
    },
    "password_encrypted": {
      "type": "string",
      "description": "Password (encrypted)"
    },
    "url": {
      "type": "string",
      "description": "URL \u0e40\u0e27\u0e47\u0e1a\u0e44\u0e0b\u0e15\u0e4c (\u0e16\u0e49\u0e32\u0e21\u0e35)"
    },
    "notes": {
      "type": "string",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38"
    },
    "last_modified_by": {
      "type": "string",
      "description": "email \u0e1c\u0e39\u0e49\u0e41\u0e01\u0e49\u0e44\u0e02\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14"
    },
    "last_modified_by_name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e41\u0e01\u0e49\u0e44\u0e02\u0e25\u0e48\u0e32\u0e2a\u0e38\u0e14"
    },
    "change_history": {
      "type": "array",
      "description": "\u0e1b\u0e23\u0e30\u0e27\u0e31\u0e15\u0e34\u0e01\u0e32\u0e23\u0e41\u0e01\u0e49\u0e44\u0e02 credential",
      "items": {
        "type": "object",
        "properties": {
          "changed_at": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_by_name": {
            "type": "string"
          },
          "fields_changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "service_id",
    "username",
    "password_encrypted"
  ]
}